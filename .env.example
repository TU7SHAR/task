# ---------------------------------------------------------------------------
# Example environment variables for the Flask + MongoDB app.
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env            (macOS/Linux)
#     Copy-Item .env.example .env     (Windows PowerShell)
#
# `.env` is gitignored — never commit real credentials.
#
# The app reads these in app.py. You have TWO options:
#   Option A: set the single MONGODB_URI (takes priority over everything else).
#   Option B: leave MONGODB_URI blank and set the individual pieces below;
#             the app assembles the connection string for you.
# ---------------------------------------------------------------------------

# --- Option A: full connection string (overrides the pieces below) ----------
# Local, no auth (matches Part 1 of the assignment):
#   MONGODB_URI=mongodb://localhost:27017/
# Authenticated:
#   MONGODB_URI=mongodb://admin:SuperSecret123@localhost:27017/?authSource=admin
MONGODB_URI=

# --- Option B: individual pieces (used only when MONGODB_URI is empty) -------
# Host of the MongoDB server.
#   - Local Docker:            localhost
#   - Inside Kubernetes:       mongodb-0.mongodb   (StatefulSet pod DNS name)
MONGODB_HOST=localhost

# Port MongoDB listens on.
MONGODB_PORT=27017

# Credentials. Leave BOTH blank for an unauthenticated local connection.
# For auth, these must match the MongoDB root user (the K8s Secret values).
MONGODB_USERNAME=admin
MONGODB_PASSWORD=SuperSecret123

# Database the credentials authenticate against. For the mongo image's root
# user this is "admin".
MONGODB_AUTH_SOURCE=admin

# --- Flask dev settings (optional, used when running `flask run` locally) ---
FLASK_APP=app.py
FLASK_ENV=development
